# Скопируйте в .env (scripts/up.sh делает это сам при первом запуске).
# ОБЯЗАТЕЛЬНО для входа в панель — ключи Clerk (https://dashboard.clerk.com → API Keys):
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# LLM для agent-engine (любой OpenAI-совместимый сервер). Без ключа агенты работают без LLM.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=
# Заполняются автоматически scripts/up.sh:
DATABASE_URL=postgresql://agent360:agent360@localhost:5432/agent360
SESSION_SECRET=
# Необязательно: поиск для аналитика
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
